# Copy to .env and adjust for local development. No real secrets are required.

# 1 = Flask debug mode with auto-reload, 0 = off
FLASK_DEBUG=1

# Port for `python run.py`
PORT=5000

# Used to sign session cookies / flash messages. Any random string works locally.
SECRET_KEY=change-me

# Path to the SQLite database file (relative to the project root or absolute).
# Defaults to ./swim.db when unset.
SWIMMATCH_DB_PATH=swim.db

# Separate SQLite file for login accounts (email, password hash, swimmer/coach role).
# Defaults to ./auth.db when unset. Unencrypted, local development only.
SWIMMATCH_AUTH_DB_PATH=auth.db
